# Template only. Copy to .env for local overrides; .env is gitignored and must never be committed.
# These values are local-development defaults, not secrets. Real secrets live in AWS Secrets Manager.
# Validated at start-up by loadConfig() in packages/shared (S0.6); a test checks this file stays complete.

# --- Runtime ---
# development | test | staging | production
APP_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Sending (ADR-011) ---
# sink (local/CI) | sandbox (staging) | live (production only, after the readiness gate).
SENDING_MODE=sink
# Required only when SENDING_MODE=live in production. Set by the release pipeline, never by hand.
# SENDING_LIVE_APPROVED_AT=2027-03-01T10:00:00Z
# SENDING_LIVE_APPROVED_BY=release-pipeline

# --- Database (docs/04-database-design.md §2) ---
# Apps connect as the restricted runtime role: not the owner, no BYPASSRLS (ADR-002).
DATABASE_URL=postgres://app_user:dm_local_app_user@127.0.0.1:5432/dhanuka
# `pnpm db:migrate` connects as the schema owner. CI/CD only outside local development.
DATABASE_MIGRATOR_URL=postgres://app_migrator:dm_local_migrator@127.0.0.1:5432/dhanuka
# `pnpm db:bootstrap` connects as the docker-compose superuser to create the roles. Local only.
DATABASE_BOOTSTRAP_URL=postgres://dm_bootstrap:dm_local_dev_only@127.0.0.1:5432/dhanuka
# Role passwords that `pnpm db:bootstrap` sets; they must match the URLs above.
APP_MIGRATOR_PASSWORD=dm_local_migrator
APP_USER_PASSWORD=dm_local_app_user
ADMIN_USER_PASSWORD=dm_local_admin_user

# --- Valkey (ADR-004): two separate instances ---
VALKEY_QUEUE_URL=redis://127.0.0.1:6379
VALKEY_CACHE_URL=redis://127.0.0.1:6380

# --- API (apps/api, Sprint 1) ---
# The web app's public origin: links in system emails point here, and it is the only origin allowed
# to make state-changing API requests (CSRF check).
APP_URL=http://127.0.0.1:3000
# Mailpit's HTTP API, used by the sink provider when SENDING_MODE=sink.
MAILPIT_URL=http://127.0.0.1:8025
SYSTEM_MAIL_FROM=no-reply@dhanuka.local
# Platform-verified team addresses that sandbox mode may deliver to (comma-separated; staging only).
SANDBOX_ALLOWLIST=
# local (bundled list) | local+hibp (also the Have I Been Pwned k-anonymity range API)
PASSWORD_BREACH_CHECK=local
# Proxies trusted for the client IP. Locally the Next.js /api rewrite runs on loopback.
TRUST_PROXY=127.0.0.1
# Where apps/web proxies /api/* (read when the web app builds and starts).
API_ORIGIN=http://127.0.0.1:3001
# Key-encryption key for MFA secrets (S2.1): 32 random bytes, base64. Optional in development and test:
# when unset, a fixed, publicly known development key is used. Staging and production use AWS KMS and
# refuse to start with a local key. To use your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MFA_LOCAL_KEK=
MFA_LOCAL_KEK_ID=local-dev-1

# --- HTTP (per app; ports are assigned in S0.8) ---
HOST=127.0.0.1
# PORT is set per app.

# --- Local Docker Compose services (infra/docker/docker-compose.yml) ---
POSTGRES_USER=dm_bootstrap
POSTGRES_PASSWORD=dm_local_dev_only
POSTGRES_DB=dhanuka
POSTGRES_PORT=5432
VALKEY_QUEUE_PORT=6379
VALKEY_CACHE_PORT=6380
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
ELASTICMQ_PORT=9324
