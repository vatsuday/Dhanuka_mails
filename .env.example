# Template only. Copy to .env for local overrides; .env is gitignored and must never be committed.
# These values are local-development defaults, not secrets. Real secrets live in AWS Secrets Manager.
# Validated at start-up by loadConfig() in packages/shared (S0.6); a test checks this file stays complete.

# --- Runtime ---
# development | test | staging | production
APP_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Sending (ADR-011) ---
# sink (local/CI) | sandbox (staging) | live (production only, after the readiness gate).
SENDING_MODE=sink
# Required only when SENDING_MODE=live in production. Set by the release pipeline, never by hand.
# SENDING_LIVE_APPROVED_AT=2027-03-01T10:00:00Z
# SENDING_LIVE_APPROVED_BY=release-pipeline

# --- Database ---
# Local bootstrap superuser from docker-compose. The app connects as the restricted app_user role once
# S0.4 creates it; this URL will change then.
DATABASE_URL=postgres://dm_bootstrap:dm_local_dev_only@127.0.0.1:5432/dhanuka

# --- Valkey (ADR-004): two separate instances ---
VALKEY_QUEUE_URL=redis://127.0.0.1:6379
VALKEY_CACHE_URL=redis://127.0.0.1:6380

# --- HTTP (per app; ports are assigned in S0.8) ---
HOST=127.0.0.1
# PORT is set per app.

# --- Local Docker Compose services (infra/docker/docker-compose.yml) ---
POSTGRES_USER=dm_bootstrap
POSTGRES_PASSWORD=dm_local_dev_only
POSTGRES_DB=dhanuka
POSTGRES_PORT=5432
VALKEY_QUEUE_PORT=6379
VALKEY_CACHE_PORT=6380
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
ELASTICMQ_PORT=9324
ELASTICMQ_UI_PORT=9325
