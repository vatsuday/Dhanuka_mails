{
  "name": "@dm/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Config loading, logging, request IDs, health checks and HTTP service bootstrap shared by all apps",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
