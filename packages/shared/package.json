    "test:integration": "vitest run --dir test/integration --hookTimeout 180000 --testTimeout 30000"
  },
  "dependencies": {
    "@types/pg": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dm/config": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
