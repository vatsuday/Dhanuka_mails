{
  "name": "@dm/db",
  "version": "0.0.0",
  "private": true,
  "description": "Postgres roles, Drizzle schema, SQL migrations, row-level security and withTenant()",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./test/postgres.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test:integration": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:bootstrap": "node --env-file-if-exists=../../.env src/cli.ts bootstrap",
    "db:migrate": "node --env-file-if-exists=../../.env src/cli.ts migrate"
  },
  "dependencies": {
    "@types/pg": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@dm/config": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
