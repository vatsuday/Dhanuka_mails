# Dependencies
node_modules/
.pnpm-store/

# Build output and caches
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
coverage/

# Test artefacts
playwright-report/
test-results/
blob-report/

# Environment files and secrets: never commit real values.
# Only the *.example templates are tracked.
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Terraform state and local files (infra comes in Sprint 2)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
