{
  "name": "@dm/api",
  "version": "0.0.0",
  "private": true,
  "description": "Tenant-facing REST API (dashboard and public API).",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts",
    "start": "node src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "@dm/channels": "workspace:*",
    "@dm/core": "workspace:*",
    "@dm/db": "workspace:*",
    "@dm/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dm/config": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "otplib": "catalog:",
    "pg": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
